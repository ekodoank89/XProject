package com.aya.xproject.ui.jitter

import androidx.lifecycle.ViewModel
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import javax.inject.Inject

data class JitterSettings(
    val stepDistance: Double = 0.0001,
    val intervalMs: Long = 1000L,
    val maxRadius: Double = 50.0
)

@HiltViewModel
class JitterViewModel @Inject constructor() : ViewModel() {

    private val _uiState = MutableStateFlow(JitterUiState())
    val uiState: StateFlow<JitterUiState> = _uiState.asStateFlow()

    private val _settings = MutableStateFlow(JitterSettings())
    val settings: StateFlow<JitterSettings> = _settings.asStateFlow()

    private val _selectedTab = MutableStateFlow("GRB")
    val selectedTab: StateFlow<String> = _selectedTab.asStateFlow()

    fun selectTab(tab: String) {
        _selectedTab.value = tab
    }

    fun onStepChanged(step: Double) {
        _settings.update { it.copy(stepDistance = step) }
    }

    fun onIntervalChanged(interval: Long) {
        _settings.update { it.copy(intervalMs = interval) }
    }

    fun onRadiusChanged(radius: Double) {
        _settings.update { it.copy(maxRadius = radius) }
    }

    fun resetToDefault() {
        _settings.value = JitterSettings()
    }
}
